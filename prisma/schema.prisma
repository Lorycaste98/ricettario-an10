generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String
  servings    Int?
  /** Unità delle porzioni (es. "teglie da 28cm", "pirofile"); nullo = persone/porzioni */
  servingsUnit String?
  prep        Int?
  cook        Int?
  notes       String?
  links       String?
  photo       String?
  cookCount   Int      @default(0)
  published   Boolean  @default(true)
  /** Ricetta "veloce": solo nome, senza scheda. Selezionabile nei menù ma esclusa da libreria/ricerca e senza pagina di dettaglio. */
  quick       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  RecipeCategory[]
  ingredients Ingredient[]
  steps       Step[]
  photos      RecipePhoto[]
  tags        RecipeTag[]
  reviews     Review[]
  menus       MenuRecipe[]
  cookLogs    CookLog[]
  progress    RecipeProgress[]
  ratings     RecipeRating[]
}

model CookLog {
  id        Int      @id @default(autoincrement())
  cookedAt  DateTime @default(now())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([cookedAt])
  @@index([recipeId])
}

model Category {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  color     String
  sortOrder Int              @default(0)
  recipes   RecipeCategory[]
}

model RecipeCategory {
  recipeId   Int
  categoryId Int
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([recipeId, categoryId])
}

model Ingredient {
  id          Int     @id @default(autoincrement())
  name        String
  qty         Float?
  unit        String?
  description String?
  /** Ingrediente facoltativo: mostrato con l'etichetta "opzionale" (dettaglio, lista spesa, PDF) */
  optional    Boolean @default(false)
  /** Sezione/preparazione di cui fa parte (es. "Per l'impasto"); null = nessuna sezione */
  section     String?
  order       Int
  recipeId    Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /** Step della procedura che usano questo ingrediente */
  steps       StepIngredient[]
}

model IngredientMaster {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  excludedFromStats Boolean @default(false)
}

model Step {
  id       Int    @id @default(autoincrement())
  text     String
  mins     Int?
  /** Tipo di tempo dello step: PREP | COOK | WAIT (attesa passiva) */
  kind     String @default("PREP")
  order    Int
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /** Ingredienti che servono per questo passo (opzionale: le ricette esistenti non ne hanno) */
  ingredients StepIngredient[]
}

/** Ingredienti necessari a un singolo passo della procedura (many-to-many Step ↔ Ingredient).
    Sempre entro la stessa ricetta: il PUT ricetta fa delete-recreate di step e ingredienti,
    quindi queste righe vengono riscritte a ogni salvataggio a partire dagli indici del form. */
model StepIngredient {
  stepId       Int
  ingredientId Int
  step         Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([stepId, ingredientId])
  @@index([ingredientId])
}

model RecipePhoto {
  id       Int    @id @default(autoincrement())
  url      String
  order    Int    @default(0)
  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Tag {
  id      Int         @id @default(autoincrement())
  name    String      @unique
  recipes RecipeTag[]
}

model RecipeTag {
  recipeId Int
  tagId    Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([recipeId, tagId])
}

model Review {
  id        Int      @id @default(autoincrement())
  nickname  String
  /** Voto 1-10. Le recensioni con menuId nullo sono note personali dell'admin (nessun voto pubblico diretto). */
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /** Menù da cui arriva la recensione (nullo = nota personale dell'admin, non legata a un'occasione specifica). */
  menuId    Int?
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)
}

model Admin {
  id         Int     @id @default(autoincrement())
  username   String  @unique
  password   String
  role       String  @default("ADMIN")
  firstLogin Boolean @default(true)
  dedication String?

  recipeProgress RecipeProgress[]
  recipeRatings  RecipeRating[]
}

/** Voto personale dell'admin su una ricetta (uno per account): 1-10 + nota opzionale.
    Distinto dalle recensioni ospiti (Review) e NON incluso nella media pubblica. */
model RecipeRating {
  adminId   Int
  recipeId  Int
  /** Voto 1-10 */
  rating    Int
  /** Nota personale opzionale (promemoria dello chef) */
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin  Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([adminId, recipeId])
  @@index([recipeId])
}

/** Avanzamento passi di una ricetta per admin (persistito per account, sync tra dispositivi) */
model RecipeProgress {
  adminId    Int
  recipeId   Int
  /** Indici 0-based degli step completati — gli id degli step sono instabili (delete-recreate al PUT ricetta) */
  doneSteps  Int[]    @default([])
  /** Numero di step al momento del salvataggio: guardia anti-stale */
  stepsCount Int      @default(0)
  updatedAt  DateTime @updatedAt

  admin  Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([adminId, recipeId])
}

model Menu {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  date        DateTime?
  /** Orario di servizio "HH:mm" (opzionale); usato per il countdown "quando iniziare" */
  servingTime String?
  /** Numero di persone previste per il menù (opzionale, uso futuro — non ancora consumato altrove) */
  people      Int?
  photo       String?
  /** Nota admin del menù (privata, come le note della ricetta ma senza voto) */
  notes       String?
  /** Totale speso per la spesa alimentari (inserito dalla lista spesa; alimenta la sezione Costi) */
  groceryCost Float?
  /** Ore di manodopera (sezione Costi) */
  laborHours  Float?
  /** Prezzo orario della manodopera in € (sezione Costi) */
  laborRate   Float?
  /** Ricarico % scelto per il prezzo di vendita (sezione Costi) */
  markupPercent Float?
  /** Visibilità del menù: false = "non pronto", nascosto ai visitatori (come Recipe.published) */
  published   Boolean      @default(true)
  /** Token segreto per il link pubblico "recensisci le ricette di questo menù" (/recensisci/[token]) */
  reviewToken String       @unique
  /** Contatore recensioni anonime di questo menù: alimenta il nickname progressivo "Ospite N" */
  anonymousReviewCount Int @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  recipes       MenuRecipe[]
  /** Storico: recensioni al menù nel suo complesso, formato dismesso — non se ne creano più di nuove */
  reviews       MenuReview[]
  /** Recensioni ricetta arrivate tramite il link di recensione di questo menù */
  recipeReviews Review[]
  /** Voci di costo generiche ("altri costi") della sezione Costi (solo admin) */
  costs         MenuCost[]
  /** Ingredienti "extra" aggiunti a mano alla lista spesa, specifici di questo menù */
  extraItems    MenuExtraItem[]
}

/** Voce di costo generica di un menù ("altri costi": gas/energia, trasporto, confezionamento…). */
model MenuCost {
  id     Int    @id @default(autoincrement())
  menuId Int
  order  Int    @default(0)
  label  String
  amount Float  @default(0)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

/** Ingrediente "extra" della lista spesa di un menù (non presente nelle ricette, comprato comunque). */
model MenuExtraItem {
  id     Int     @id @default(autoincrement())
  menuId Int
  order  Int     @default(0)
  name   String
  qty    Float?
  unit   String?
  menu   Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model MenuRecipe {
  menuId    Int
  recipeId  Int
  order     Int    @default(0)
  /** Porzioni della ricetta in questo menù (override del default della ricetta); nullo = usa Recipe.servings.
      Usato per scalare le quantità degli ingredienti nella lista della spesa del menù. */
  servings  Int?
  /** Inizio pianificato della ricetta nella modalità cucina (timeline); nullo = calcolo automatico dal servizio */
  cookStartAt DateTime?
  menu      Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([menuId, recipeId])
}

model MenuReview {
  id        Int      @id @default(autoincrement())
  nickname  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
}
